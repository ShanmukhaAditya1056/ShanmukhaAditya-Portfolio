# Copy to server/.env and fill in. Never commit server/.env.
PORT=5000
NODE_ENV=development

# ---- Storage (optional — messages are also emailed) ----
# Local MongoDB or a MongoDB Atlas connection string. Leave empty to skip storing messages.
MONGO_URI=mongodb://127.0.0.1:27017/portfolio

# ---- CORS ----
# http://localhost:5173 and https://shanmukhaaditya-portfolio.vercel.app are always allowed.
# Add extra origins here, comma-separated (e.g. a preview deployment).
CLIENT_ORIGIN=

# ---- Outgoing email (Nodemailer / SMTP) ----
# Gmail: smtp.gmail.com, port 587, user = your Gmail, pass = a 16-char App Password (not your login password).
# Resend: smtp.resend.com, port 587, user = "resend", pass = your Resend API key.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=madalaadithya1056@gmail.com
SMTP_PASS=
# Where notifications go, and the From header (must be a sender your SMTP provider allows).
CONTACT_TO=madalaadithya1056@gmail.com
CONTACT_FROM="Shanmukha Aditya – Portfolio" <madalaadithya1056@gmail.com>
CONTACT_OWNER_NAME=Shanmukha Aditya
# Thank-you email to the visitor (also acts as a bounce trap). Set to false to disable.
SEND_AUTO_REPLY=true
# Links used in the thank-you email
SITE_URL=https://shanmukhaaditya-portfolio.vercel.app
OWNER_GITHUB=https://github.com/ShanmukhaAditya1056
OWNER_LINKEDIN=https://www.linkedin.com/in/shanmukhaaditya-madala/

# ---- Mailbox existence verification (optional but recommended) ----
# Provider: abstract (default, https://www.abstractapi.com/api/email-verification-validation-api),
#           hunter (https://hunter.io/email-verifier) or zerobounce (https://www.zerobounce.net).
# Without a key the server still blocks disposable domains and domains with no mail server,
# but cannot tell whether e.g. xy21@gmail.com is a real mailbox.
# abstract = AbstractAPI "Email Reputation" (current product, https://app.abstractapi.com/api/email-reputation)
# abstract-validation = AbstractAPI legacy "Email Validation" · hunter · zerobounce
EMAIL_VERIFICATION_PROVIDER=abstract
EMAIL_VERIFICATION_API_KEY=
